{
  "name": "market-check",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mock": "node scripts/dev.mjs --mock",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/test/run.mjs",
    "check": "npm run typecheck && npm test",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2024-09-23",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=market-check",
    "smoke": "node scripts/smoke-live.mjs"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/d3-time": "^3.0.3",
    "@types/matter-js": "^0.20.2",
    "esbuild": "^0.25.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "wrangler": "^3.112.0"
  },
  "dependencies": {
    "animejs": "^4.3.6",
    "d3-array": "^3.2.4",
    "d3-hierarchy": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "matter-js": "^0.20.0"
  }
}
