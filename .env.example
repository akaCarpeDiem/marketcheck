# Build-time settings for scripts/build.mjs. All optional: a clean clone builds
# the site exactly as it is published. Copy to .env to change one. Names only,
# never real secrets (see AGENTS.md).

# AdSense publisher id. Defaults to the site's own id, which is public and also
# in public/ads.txt. Set to an empty value to build without ads.
# VITE_ADSENSE_CLIENT=ca-pub-4059575347806121

# Ad unit id for the in-page slots. Leave unset to let AdSense choose (auto ads).
# VITE_ADSENSE_SLOT=1234567890

# Force one refresh interval (ms) for all prices. Leave unset for the normal
# schedule: faster while the US market is open, slower when it is shut.
# VITE_REFRESH_MS=60000

# Cloudflare Pages secrets (Functions — set in dashboard / wrangler, not Vite):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Azure App registration — Accounts in any org + personal Microsoft accounts)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Redirect URI (Web): https://marketcheck.money/api/auth/microsoft/callback
# SESSION_SECRET=   # long random string for HMAC session cookie (LAYOUTS KV also required)
# PUBLIC_ORIGIN=https://marketcheck.money

# Optional: a free CoinGecko demo key. Used only to retry when CoinGecko refuses the keyless request (HTTP 429).
# COINGECKO_API_KEY=

# Resend email magic-link / code sign-in (any email address)
# RESEND_API_KEY=   # from the Resend dashboard (do not invent)
# MAGIC_FROM_EMAIL=Market Check <noreply@marketcheck.money>
#   # Requires marketcheck.money to be verified in Resend (Resend → Domains), with the
#   # exact DNS records Resend shows added in Cloudflare → marketcheck.money → DNS.
#   # Test-only fallback (delivers only to your Resend account email): Market Check <onboarding@resend.dev>
# The contact address is not a setting: it is support@marketcheck.money, written in content/*.html.
