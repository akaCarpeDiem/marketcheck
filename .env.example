# No secrets required for CoinGecko (public), Yahoo Finance chart proxy, or RSS headlines.
# Optional: override refresh interval (ms). Default 45000.
# VITE_REFRESH_MS=45000

# AdSense (build-time). Site verification uses head script + public/ads.txt;
# this env fills below-fold reserved slots via src/ads.ts.
# VITE_ADSENSE_CLIENT=ca-pub-4059575347806121
# VITE_ADSENSE_SLOT=1234567890

# Optional Cloudflare Web Analytics beacon (build-time). Leave unset to use
# CF dashboard Web Analytics for marketcheck.money instead (no custom beacon).
# Do not invent a token. Pageviews only — this app strips ?q= from the beacon URL.
# VITE_CF_WEB_ANALYTICS_TOKEN=

# Cloudflare Pages secrets (Functions — set in dashboard / wrangler, not Vite):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Azure App registration — Accounts in any org + personal Microsoft accounts)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Redirect URI (Web): https://marketcheck.money/api/auth/microsoft/callback
# SESSION_SECRET=   # long random string for HMAC session cookie (LAYOUTS KV also required)
# PUBLIC_ORIGIN=https://marketcheck.money

# Resend email magic-link / code sign-in (any email address)
# RESEND_API_KEY=   # from the Resend dashboard (do not invent)
# MAGIC_FROM_EMAIL=Market Check <noreply@marketcheck.money>
#   # Requires marketcheck.money to be verified in Resend (Resend → Domains), with the
#   # exact DNS records Resend shows added in Cloudflare → marketcheck.money → DNS.
#   # Test-only fallback (delivers only to your Resend account email): Market Check <onboarding@resend.dev>
# Publisher contact email is NOT an env var — set PUBLISHER_EMAIL in src/publisher.ts
# (leave empty until a real inbox is published; do not use example.com).
